# Hosted backend only. Set these in Vercel's Environment Variables settings.
# Use Neon's pooled connection URL and retain its SSL parameters.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Use the direct (unpooled) URL for explicit migrations and cold-start migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
# Apply versioned migrations on cold start (serialized across instances).
AUTO_MIGRATE=1

# Neon Auth (managed Better Auth). Sign-in/sign-up requests carry this trusted origin.
NEON_AUTH_BASE_URL=https://YOUR-AUTH-HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-AUTH-HOST/neondb/auth/.well-known/jwks.json
NEON_AUTH_ORIGIN=https://YOUR-PROJECT.vercel.app

# Neon Object Storage (S3-compatible). Defaults to the private `assets` bucket.
AWS_ACCESS_KEY_ID=YOUR-ACCESS-KEY
AWS_SECRET_ACCESS_KEY=YOUR-SECRET-KEY
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.REGION.aws.neon.tech
AWS_REGION=YOUR-REGION
NEON_STORAGE_BUCKET=assets

# Neon Realtime. The secret is server-only; the URL is safe for the browser.
NEON_REALTIME_URL=wss://YOUR-REALTIME-HOST/
NEON_REALTIME_SECRET=YOUR-REALTIME-SECRET
