{
  "name": "student-survey-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-downloads.mjs && vite --host 127.0.0.1",
    "dev:app": "vite --mode app --host 127.0.0.1",
    "build": "node scripts/prepare-downloads.mjs && vite build",
    "build:app": "vite build --mode app",
    "prepare:downloads": "node scripts/prepare-downloads.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/core.test.js",
    "test:e2e": "playwright test",
    "test:site": "playwright test --config playwright.site.config.js"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "5.1.2",
    "vite": "7.3.1"
  }
}
